<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Star Chart</string>

    <!-- ============================================================ -->
    <!-- Chart screen: the chart, and when and where under it -->

    <!-- Top bar title: the app's name -->
    <string name="chart_title">Star Chart</string>
    <!-- Cog button in the top bar, read aloud by a screen reader -->
    <string name="chart_cd_settings">Settings</string>
    <!-- Shown once, while the star catalogue loads on first start -->
    <string name="chart_loading">Reading the catalogue…</string>
    <string name="chart_loading_note">Nine thousand stars. This happens once.</string>

    <!-- The when and where fields under the chart: a value, then a qualifier after a dot. %1$s is the value, %2$s the qualifier -->
    <string name="chart_field">%1$s · %2$s</string>
    <!-- The when field's value before a time has been worked out (the present moment) -->
    <string name="chart_when_now_label">Now</string>
    <!-- Qualifier: the chart follows the clock (lower case, after the dot) -->
    <string name="chart_when_sub_now">now</string>
    <!-- Qualifier: the chart shows a moment the reader chose (past participle, "set by you"; lower case) -->
    <string name="chart_when_sub_set">set</string>
    <!-- Qualifier: the place came from the GPS -->
    <string name="chart_where_sub_gps">GPS</string>
    <!-- Qualifier: the place was typed in -->
    <string name="chart_where_sub_by_hand">by hand</string>
    <!-- The when field's value: the date and time the chart is drawn for. A java.text.SimpleDateFormat pattern, not text: d day, MMM short month name, yyyy year, HH:mm 24-hour time. Reorder the fields for your language; the month name is put in by the phone -->
    <string name="chart_when_pattern">d MMM yyyy, HH:mm</string>
    <!-- The where field's value. %1$.2f is the latitude and %3$.2f the longitude, both without a sign; %2$s and %4$s are the compass letters below that say which side of the equator and of Greenwich -->
    <string name="chart_where_value">%1$.2f°%2$s %3$.2f°%4$s</string>

    <!-- Single-letter compass points: around the rim of the chart, and after a latitude (N/S) or longitude (E/W) -->
    <!-- North -->
    <string name="compass_north">N</string>
    <!-- East -->
    <string name="compass_east">E</string>
    <!-- South -->
    <string name="compass_south">S</string>
    <!-- West -->
    <string name="compass_west">W</string>

    <!-- The button under the chart that turns it: which compass point is at the top -->
    <string name="chart_facing_north">North up</string>
    <string name="chart_facing_east">East up</string>
    <string name="chart_facing_south">South up</string>
    <string name="chart_facing_west">West up</string>
    <!-- The same button when zoomed in. %1$s is one of the four above, %2$.1f the zoom (×2.5 means two and a half times). Keep the two spaces, and the quotes that keep them -->
    <string name="chart_facing_zoomed">"%1$s  ×%2$.1f"</string>

    <!-- Point: the chart follows the way the phone's back points at the sky -->
    <!-- Button beside the facing button that turns Point on (verb: point the phone) -->
    <string name="point_point">Point</string>
    <!-- The same button while Point is on: back to the whole-sky chart -->
    <string name="point_whole_sky">Whole sky</string>
    <!-- While Point is on, the facing button freezes the view (verb) -->
    <string name="point_hold">Hold</string>
    <!-- The same button while the view is held: follow the phone again (verb) -->
    <string name="point_follow">Follow</string>
    <!-- Under the chart before the phone has first come to rest -->
    <string name="point_waiting">Hold the phone up to the sky</string>
    <!-- Under the chart when no named star or planet is near the cross in the middle -->
    <string name="point_nothing_named">Nothing named near the cross</string>
    <!-- The star under the cross and its constellation, e.g. "Vega, in Lyra". %1$s is the star, %2$s the constellation -->
    <string name="point_star_in">%1$s, in %2$s</string>
    <!-- Shown when the phone says its compass reading is poor -->
    <string name="point_compass_unsure">Compass unsure — move the phone in a figure 8</string>

    <!-- Names beside the Sun, the Moon and the planets on the chart, and over their details when tapped -->
    <string name="body_sun">Sun</string>
    <string name="body_moon">Moon</string>
    <string name="planet_mercury">Mercury</string>
    <string name="planet_venus">Venus</string>
    <string name="planet_mars">Mars</string>
    <string name="planet_jupiter">Jupiter</string>
    <string name="planet_saturn">Saturn</string>
    <string name="planet_uranus">Uranus</string>
    <string name="planet_neptune">Neptune</string>

    <!-- ============================================================ -->
    <!-- Where dialog: the place the sky is charted from -->

    <string name="where_title">Where</string>
    <!-- Labels above the two number fields -->
    <string name="where_latitude">Latitude, degrees</string>
    <string name="where_longitude">Longitude, degrees</string>
    <!-- The N/S and E/W buttons beside the two fields, read aloud by a screen reader -->
    <string name="where_cd_north_south">North or south of the equator; tap to change</string>
    <string name="where_cd_east_west">East or west of Greenwich; tap to change</string>
    <string name="where_out_of_range">Latitude runs 0 to 90, longitude 0 to 180.</string>
    <!-- Button: chart from the typed place -->
    <string name="where_use_this">Use this</string>
    <string name="where_ask_gps">Ask the GPS</string>
    <string name="where_no_fix">The phone has no recent fix. Step outside and try again, or set it by hand — a chart is not fussy about a mile.</string>
    <string name="where_cancel">Cancel</string>

    <!-- ============================================================ -->
    <!-- When dialog: the moment the sky is charted for -->

    <string name="when_title">When</string>
    <!-- Label above three fields: year, month and day, in that order -->
    <string name="when_date">Year, month, day</string>
    <!-- Label above two fields: hour and minute, in the phone's time zone -->
    <string name="when_time">Hour and minute, on this phone\'s clock</string>
    <string name="when_bad_date">That is not a date this can chart.</string>
    <!-- Four small step buttons: back a day, back an hour, forward an hour, forward a day. Keep them short; the minus is U+2212 -->
    <string name="when_step_back_day">− day</string>
    <string name="when_step_back_hour">− hr</string>
    <string name="when_step_forward_hour">+ hr</string>
    <string name="when_step_forward_day">+ day</string>
    <string name="when_chart_this_moment">Chart this moment</string>
    <!-- Button: go back to following the clock -->
    <string name="when_back_to_now">Back to now</string>
    <string name="when_cancel">Cancel</string>

    <!-- ============================================================ -->
    <!-- Object dialog: what was tapped on the chart -->

    <!-- Title when the tapped thing has no name -->
    <string name="object_title_fallback">Object</string>
    <!-- One line of facts. %1$s is the label below, %2$s its value -->
    <string name="object_line">%1$s: %2$s</string>
    <!-- A star's Bayer or Flamsteed designation, e.g. Alpha Lyrae -->
    <string name="object_designation">Designation</string>
    <!-- The star's number in a catalogue (noun) -->
    <string name="object_catalogue">Catalogue</string>
    <!-- Astronomical brightness -->
    <string name="object_magnitude">Magnitude</string>
    <!-- What sort of body it is (noun) -->
    <string name="object_kind">Kind</string>
    <string name="object_kind_sun">The Sun</string>
    <string name="object_kind_moon">The Moon</string>
    <string name="object_kind_planet">Planet</string>
    <!-- The Moon's phase (noun) -->
    <string name="object_phase">Phase</string>
    <!-- %1$s is one of the phase names below, %2$d the percent lit -->
    <string name="object_phase_value">%1$s, %2$d%% lit</string>
    <!-- The Moon's phases, as an almanac names them. Lower case: they begin the line above -->
    <string name="phase_new">new</string>
    <string name="phase_waxing_crescent">waxing crescent</string>
    <string name="phase_first_quarter">first quarter</string>
    <string name="phase_waxing_gibbous">waxing gibbous</string>
    <string name="phase_full">full</string>
    <string name="phase_waning_gibbous">waning gibbous</string>
    <string name="phase_last_quarter">last quarter</string>
    <string name="phase_waning_crescent">waning crescent</string>
    <!-- Height above the horizon in degrees (astronomy, not height above the sea) -->
    <string name="object_altitude">Altitude</string>
    <string name="object_altitude_value">%1$.1f° above the horizon</string>
    <!-- Compass bearing in degrees -->
    <string name="object_azimuth">Azimuth</string>
    <string name="object_azimuth_value">%1$.1f° from north</string>
    <!-- Button (verb) -->
    <string name="object_close">Close</string>

    <!-- ============================================================ -->
    <!-- Settings screen: what is drawn on the chart -->

    <string name="settings_title">Settings</string>
    <!-- Top bar buttons, read aloud by a screen reader -->
    <string name="settings_cd_close">Close</string>
    <string name="settings_cd_about">About</string>

    <!-- The magnitude limit row. Its value: %1$.0f is the magnitude, 3 to 6, and %2$s one of the three short notes below, saying roughly what that limit shows -->
    <string name="settings_faintest_star">Faintest star</string>
    <string name="settings_magnitude_value">%1$.0f · %2$s</string>
    <string name="settings_magnitude_note_bright">bright ones</string>
    <string name="settings_magnitude_note_town">a town sky</string>
    <string name="settings_magnitude_note_dark">a dark sky</string>

    <!-- How heavy the chart's lines and dots are drawn -->
    <string name="settings_mark_weight">Mark weight</string>
    <!-- Its three values: the thickness of the lines and dots, thinnest first (not a font weight) -->
    <string name="settings_mark_weight_fine">Fine</string>
    <string name="settings_mark_weight_medium">Medium</string>
    <string name="settings_mark_weight_bold">Bold</string>

    <!-- Layer toggles -->
    <!-- The stick figures joining a constellation's stars -->
    <string name="settings_constellation_figures">Constellation figures</string>
    <!-- Its value is Off or one of the three kinds of name below -->
    <string name="settings_constellation_names">Constellation names</string>
    <!-- The three kinds of name. "English" is the English translation of the Latin, e.g. Great Bear; the names themselves come from the catalogue in English -->
    <string name="settings_call_them_latin">Latin</string>
    <string name="settings_call_them_english">English</string>
    <!-- The three-letter IAU abbreviation, e.g. UMa -->
    <string name="settings_call_them_abbreviation">Abbreviation</string>
    <string name="settings_constellation_boundaries">Constellation boundaries</string>
    <string name="settings_star_names">Star names</string>
    <!-- Its value is Off, or one of the two below: drawn with their names beside them, or without -->
    <string name="settings_solar_system">Sun, Moon and planets</string>
    <string name="settings_solar_named">Named</string>
    <string name="settings_solar_unnamed">Unnamed</string>
    <string name="settings_ecliptic">Ecliptic</string>
    <string name="settings_equator">Celestial equator</string>
    <string name="settings_grid">Declination grid</string>
    <string name="settings_altitude_circles">Altitude circles</string>
    <!-- Whether the app turns to landscape when the phone is turned on its side -->
    <string name="settings_turn">Turn sideways with the phone</string>
    <!-- A toggle row's value: the layer is shown / hidden -->
    <string name="settings_on">On</string>
    <string name="settings_off">Off</string>

    <!-- ============================================================ -->
    <!-- About dialog. Keep the names of the app, people, projects, catalogues and licences as they are -->

    <!-- Heading. %1$s is the version number, e.g. 0.1.0 -->
    <string name="about_title">Star Chart %1$s</string>
    <string name="about_black_on_white">Black on white, like a paper chart. A screen full of black would be unreadable outdoors and slow to redraw here.</string>
    <string name="about_catalogue">Stars from the Yale Bright Star Catalogue. Every position is computed on the phone.</string>
    <!-- Heading above the privacy paragraph -->
    <string name="about_privacy_heading">Privacy</string>
    <!-- "Ask the GPS" and "Point" are the names of buttons in the app; keep them the same as there -->
    <string name="about_privacy_body">Everything you put in this app stays on this phone. It has no internet access, so nothing is sent anywhere, and nothing is collected about you. It asks for your rough location only when you press Ask the GPS. The compass and motion sensors are read on the phone only while Point is on. There are no ads, no analytics and no tracking.</string>
    <!-- Heading above the terms paragraph -->
    <string name="about_terms_heading">Terms</string>
    <string name="about_terms_body">This app is free software under the GNU General Public License v3 or later. It comes with no warranty: use it at your own risk.</string>
    <string name="about_after">After AndroidPlanisphere by Timo Engel, whose astronomy this runs on unchanged.</string>
    <string name="about_icons">Icons from Material Symbols, Apache 2.0</string>
    <!-- The donation link label, beside a drawing of a llama. A fixed phrase: a verb and an object, so the reader knows what pressing it does -->
    <string name="about_feed_the_llamas">feed the llamas</string>
    <!-- Toast when the donation link cannot be opened -->
    <string name="about_no_browser">There is no browser on this phone to open that with.</string>
    <!-- Button that closes the About dialog -->
    <string name="about_close">Close</string>
</resources>
