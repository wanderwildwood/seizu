<?xml version="1.0" encoding="utf-8"?>
<!-- The Plough, unmasked: seven stars and the line that joins them. The asterism almost everyone
     can already find, and the one that points the way to everything else.

     Geometric rather than hand-drawn, unlike the other marks in this shop - this one is
     an MMD-style icon: exact circles, one stroke weight, no wobble. A constellation is a
     figure people match against the real sky, and a wobbling copy of it would be a worse
     figure rather than a warmer one.

     Weights are set to sit alongside the bubble vial and the speedometer dial at launcher
     size; drawn finer, this one went thin next to them.

     Sizes follow the real magnitudes. Megrez, where the handle meets the bowl, is the
     faint one, and is drawn smallest for the same reason it looks that way overhead.

     Everything sits inside the central 66 units the launcher mask is certain to keep. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:fillColor="#FFFFFF" android:pathData="M0,0h108v108h-108z" />

    <!-- the joining line: up the handle, round the bowl, back to Megrez -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="3.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M27.1,45.7 L39.3,47.6 L51.6,48.8 L63.8,51.9 L80.9,47.6 L78.5,59.8 L67.5,62.3 L63.8,51.9" />

    <!-- Alkaid -->
    <path android:fillColor="#000000" android:pathData="M22.7,45.7 A4.4,4.4 0 1 0 31.4,45.7 A4.4,4.4 0 1 0 22.7,45.7 Z" />
    <!-- Mizar -->
    <path android:fillColor="#000000" android:pathData="M35.2,47.6 A4.1,4.1 0 1 0 43.4,47.6 A4.1,4.1 0 1 0 35.2,47.6 Z" />
    <!-- Alioth -->
    <path android:fillColor="#000000" android:pathData="M46.9,48.8 A4.6,4.6 0 1 0 56.2,48.8 A4.6,4.6 0 1 0 46.9,48.8 Z" />
