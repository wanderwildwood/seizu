<?xml version="1.0" encoding="utf-8"?>
<!-- The unmasked icon. The Plough: seven stars and the line that joins them. The asterism almost everyone
     can already find, and the one that points the way to everything else.

     Drawn to the five rules measured off the owner's own chanterelle in
     kinokocho/tools/make-art.py: a thin line, few strokes, crooked rather than
     symmetrical, and no solid black except droplets - which is what these stars are.

     The stars carry the weight and the line is light. An earlier attempt had it the other
     way round, and with the dots reduced to specks the mark read as a bent wire rather
     than a constellation. On any real star chart the dots are the subject.

     Each dot is two half-arcs. A single arc returning to its own start is degenerate and
     is dropped silently by the renderer, which is how all seven stars disappeared once.

     Everything sits inside the central 66 units the launcher mask is certain to keep. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:fillColor="#FFFFFF" android:pathData="M0,0h108v108h-108z" />

    <!-- The line only joins; it is not the subject. Drawn light, and barely bowed:
         with more waver than this the handle reads as a wire rather than a run of
         stars, and the mark stops being the Plough. -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M26.8,45.4 Q32.7,46.9 38.8,47.7 Q45.3,48.0 51.7,48.9 Q57.7,50.6 63.8,51.6 Q72.4,49.3 81.2,47.6 Q79.9,53.6 79.2,59.6 Q73.7,61.4 68.0,62.6 Q66.2,57.0 63.8,51.6" />

    <!-- The seven, as droplets, and the subject of the drawing. Sizes follow the real
         magnitudes: Megrez, where the handle meets the bowl, is the faint one. -->
    <path android:fillColor="#000000" android:pathData="M22.98,45.56 A3.50,3.26 0 1 0 29.98,45.56 A3.50,3.26 0 1 0 22.98,45.56 Z" />
